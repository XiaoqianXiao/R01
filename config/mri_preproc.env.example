# Copy this file to config/mri_preproc.env and edit paths before running.

# Project paths
PROJECT_DIR="/project"
BIDS_DIR="${PROJECT_DIR}/rawdata/BIDS"
DERIVATIVES_DIR="${PROJECT_DIR}/derivatives"
FMRIPREP_OUT="${DERIVATIVES_DIR}/fmriprep"
FS_SUBJECTS_DIR="${DERIVATIVES_DIR}/freesurfer"
WORK_DIR="${PROJECT_DIR}/work/fmriprep"
LOG_DIR="${PROJECT_DIR}/logs/fmriprep"
PROVENANCE_DIR="${DERIVATIVES_DIR}/qc/provenance"

# Required for FreeSurfer inside fMRIPrep.
FS_LICENSE="/path/to/license.txt"

# Container runtime: docker, apptainer, or singularity.
CONTAINER_RUNTIME="apptainer"

# Freeze the exact image/digest for production.
# Docker example: nipreps/fmriprep:25.2.5
# Apptainer/Singularity example: /project/containers/fmriprep-25.2.5.sif
FMRIPREP_IMAGE="/project/containers/fmriprep-25.2.5.sif"

# Optional TemplateFlow cache on disk.
TEMPLATEFLOW_HOME="${PROJECT_DIR}/templateflow"

# Participant selection. Leave empty to run all participants.
# Example: PARTICIPANT_LABELS="sub-001 sub-002"
PARTICIPANT_LABELS=""

# Production baseline choices from the MRI preprocessing plan.
SUBJECT_ANATOMICAL_REFERENCE="unbiased"
SESSION_TRACKING_FLAG="--track-sessions"
RANDOM_SEED="20260904"
SLICE_TIME_REF="0.5"

# Set to 1 only when intentionally using the stricter skull-strip reproducibility mode.
SKULL_STRIP_FIXED_SEED="0"

# Resource controls.
NTHREADS="16"
OMP_NTHREADS="8"
MEM_MB="64000"

# Extra fMRIPrep flags can be appended here after they are explicitly frozen.
EXTRA_FMRIPREP_ARGS=""
